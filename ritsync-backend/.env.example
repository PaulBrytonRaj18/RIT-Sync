# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored and is loaded automatically by the app (spring.config.import)
# and by docker compose. NEVER commit real values.
#
# Generate strong secrets with:   openssl rand -base64 32

# ── Database (REQUIRED) ─────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/ritsync_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ritsync_user
DB_PASSWORD=change-me
# Only used by docker-compose to initialise the MySQL container
MYSQL_ROOT_PASSWORD=change-me-too

# 'update' for local dev, 'validate' for production
JPA_DDL_AUTO=update

# ── JWT (REQUIRED, at least 32 characters) ──────────────────────────
JWT_SECRET=
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ── Face descriptor encryption (REQUIRED, at least 32 bytes) ─────────
# Changing this makes previously enrolled faces unreadable (students must re-enroll).
ENCRYPTION_KEY=

# ── CORS: comma-separated frontend origins ───────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate limits (requests per minute per client IP) ──────────────────
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=300

# ── Mail (optional - device verification & alerts) ───────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend base URL (used in email links)
APP_BASE_URL=http://localhost:3000

# Redis (optional - not used yet)
REDIS_HOST=localhost
REDIS_PORT=6379
